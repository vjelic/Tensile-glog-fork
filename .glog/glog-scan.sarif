            {
              "id": "c0645d3d-ba56-3092-9412-c7dab2f16e80",
              "name": "resources.rules.raptor-insecure-api-rand-srand",
              "shortDescription": {
                "text": "Opengrep Finding: resources.rules.raptor-insecure-api-rand-srand"
              },
              "fullDescription": {
                "text": "The rand() PRNG should not be used in applications intended to be  portable when good randomness is needed. Instead, the use of random()  is recommended."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
              },
              "help": {
                "text": "The rand() PRNG should not be used in applications intended to be  portable when good randomness is needed. Instead, the use of random()  is recommended.\n💎 Enable cross-file analysis and Pro rules for free at sg.run/pro",

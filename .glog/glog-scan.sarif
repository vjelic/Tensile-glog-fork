            {
              "id": "9ececfcb-2f3a-3a32-928f-69a38f8fa233",
              "name": "resources.rules.raptor-insecure-api-rand-srand",
              "shortDescription": {
                "text": "Opengrep Finding: resources.rules.raptor-insecure-api-rand-srand"
              },
              "fullDescription": {
                "text": "The rand() PRNG should not be used in applications intended to be  portable when good randomness is needed. Instead, the use of random()  is recommended."
              },
